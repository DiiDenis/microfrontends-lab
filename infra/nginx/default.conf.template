map $uri $mfe_cache_control {
  default "no-cache, must-revalidate";
  ~^/mf-manifest\.json$ "no-store";
  ~^/remoteEntry\.js$ "no-cache, must-revalidate";
  ~^/static/ "public, max-age=31536000, immutable";
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  add_header Access-Control-Allow-Origin "${MFE_ALLOWED_ORIGIN}" always;
  add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
  add_header Access-Control-Allow-Headers "Content-Type" always;
  add_header Cache-Control $mfe_cache_control always;
  add_header Vary "Origin" always;

  if ($request_method = OPTIONS) {
    return 204;
  }

  location = /mf-manifest.json {
    try_files $uri =404;
  }

  location = /remoteEntry.js {
    try_files $uri =404;
  }

  location /static/ {
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
