{
  "name": "@mfe-lab/ui-react",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://127.0.0.1:4873/"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mfe-lab/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "0.23.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  }
}
